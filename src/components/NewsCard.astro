---
import { urlFor } from '../lib/sanity';

interface Props {
  post: {
    title: string;
    slug: { current: string };
    publishedAt: string;
    coverImage?: any;
    excerpt?: string;
  };
}

const { post } = Astro.props;

const formattedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : 'Recently';

const imageUrl = post.coverImage
  ? urlFor(post.coverImage).width(600).url()
  : null;
---

<article class="bg-white rounded-xl shadow-sm hover:shadow-md border border-slate-100 overflow-hidden flex flex-col h-full transition-all duration-300 group">
  <!-- Cover Image / Fallback -->
  <a href={`/news/${post.slug.current}`} class="relative block overflow-hidden bg-slate-100">
    {imageUrl ? (
      <img 
        src={imageUrl} 
        alt={post.title} 
        class="w-full h-auto block group-hover:scale-105 transition-transform duration-500" 
        loading="lazy"
      />
    ) : (
      <div class="w-full aspect-video flex items-center justify-center bg-gradient-to-br from-slate-100 to-brand-50 text-brand-300">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18V6a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 6v3.75m-18 0A2.25 2.25 0 0 0 5.25 12h13.5M3 12h18" />
        </svg>
      </div>
    )}
  </a>

  <!-- Card Body -->
  <div class="p-6 flex flex-col flex-grow">
    <div class="flex items-center space-x-1 text-xs text-slate-400 mb-2 font-medium">
      <time datetime={post.publishedAt}>{formattedDate}</time>
    </div>
    
    <h3 class="text-xl font-bold text-slate-900 group-hover:text-brand-600 transition-colors mb-3 line-clamp-2">
      <a href={`/news/${post.slug.current}`}>{post.title}</a>
    </h3>

    {post.excerpt && (
      <p class="text-slate-500 text-sm line-clamp-3 mb-4 leading-relaxed">
        {post.excerpt}
      </p>
    )}

    <!-- Footer link -->
    <div class="mt-auto pt-4 flex items-center justify-start">
      <a 
        href={`/news/${post.slug.current}`} 
        class="inline-flex items-center text-sm font-semibold text-brand-600 hover:text-brand-800 transition-colors group-hover:translate-x-1 duration-200"
      >
        Read Full Article
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 ml-1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</article>
