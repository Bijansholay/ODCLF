---
import { urlFor } from '../lib/sanity';

interface Props {
  member: {
    name: string;
    role: string;
    photo?: any;
    bio?: string;
    emails?: string[];
    phone?: string;
    active: boolean;
  };
}

const { member } = Astro.props;

const imageUrl = member.photo
  ? urlFor(member.photo).width(400).height(400).url()
  : null;

const initials = member.name
  ? member.name
      .split(' ')
      .map(n => n[0])
      .join('')
      .slice(0, 2)
      .toUpperCase()
  : '??';
---

<div 
  class="member-card bg-gradient-to-br from-brand-900 to-slate-950 rounded-2xl shadow-lg border-2 border-brand-500/30 p-6 flex flex-col items-center text-center hover:-translate-y-1 hover:border-brand-400 hover:shadow-2xl hover:shadow-brand-500/15 transition-all duration-300"
  data-name={member.name}
  data-role={member.role}
  data-photo={imageUrl || ''}
  data-initials={initials}
  data-bio={member.bio || ''}
  data-emails={JSON.stringify(member.emails || [])}
  data-phone={member.phone || ''}
>
  <!-- Photo / Placeholder -->
  <div class="member-detail-trigger w-24 h-24 rounded-full overflow-hidden mb-4 bg-slate-800 shrink-0 border-2 border-brand-400 relative shadow-md shadow-slate-950/40 cursor-pointer hover:scale-105 transition-all duration-300" aria-label="View biography">
    {imageUrl ? (
      <img src={imageUrl} alt={member.name} class="w-full h-full object-cover" loading="lazy" />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-brand-600 to-brand-700 text-white font-bold text-xl tracking-wider">
        {initials}
      </div>
    )}
  </div>

  <!-- Name and Role -->
  <h3 class="member-detail-trigger text-lg font-bold text-white leading-snug cursor-pointer hover:text-brand-300 transition-colors">{member.name}</h3>
  <span class="inline-block mt-1.5 text-xs font-semibold uppercase tracking-wider text-brand-300 bg-brand-950 border border-brand-900 px-2.5 py-0.5 rounded-full mb-4">
    {member.role}
  </span>

  <!-- Bio -->
  {member.bio ? (
    <div class="flex-grow flex flex-col justify-between w-full">
      <p class="text-slate-300 text-sm leading-relaxed line-clamp-3">
        {member.bio}
      </p>
      <button 
        type="button"
        class="member-detail-trigger mt-4 text-xs font-bold text-brand-400 hover:text-brand-300 focus:outline-none transition-colors self-center cursor-pointer"
      >
        Read Biography
      </button>
    </div>
  ) : (
    <p class="text-slate-400 text-xs italic">
      No biography provided.
    </p>
  )}
</div>
