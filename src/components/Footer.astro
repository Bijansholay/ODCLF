---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-400 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Info Column -->
      <div class="space-y-4">
        <div class="flex items-center space-x-2 text-white">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-.778.099-1.533.284-2.253m0 0A17.919 17.919 0 0 0 12 12.75c3.162 0 6.133-.815 8.716-2.247" />
          </svg>
          <span class="font-bold text-lg tracking-wide text-white">ODCLF Forum</span>
        </div>
        <p class="text-sm text-slate-400 max-w-xs leading-relaxed">
          An academic and research platform dedicated to fostering collaboration, sharing insights, and building community.
        </p>
      </div>

      <!-- Quick Links -->
      <div class="space-y-4">
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Navigation</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/news" class="hover:text-white transition-colors">News & Updates</a></li>
          <li><a href="/members" class="hover:text-white transition-colors">Members</a></li>
          <li><a href="/publications" class="hover:text-white transition-colors">Publications</a></li>
          <li><a href="/events" class="hover:text-white transition-colors">Events</a></li>
        </ul>
      </div>

      <!-- Contact / Metas -->
      <div class="space-y-4">
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Admin Dashboard</h3>
        <p class="text-sm text-slate-400">
          Authorized officers can log into Sanity Studio to update content.
        </p>
        <div>
          <a
            href="/studio"
            class="inline-flex items-center justify-center px-4 py-2 border border-slate-700 rounded-md text-sm font-medium text-white bg-slate-800 hover:bg-slate-700 transition-colors"
          >
            Access CMS Dashboard
          </a>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-8 pt-8 border-t border-slate-800 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-500">
      <p>&copy; {currentYear} ODCLF Forum. All rights reserved.</p>
      <p class="mt-2 sm:mt-0">Built with Astro & Sanity CMS</p>
    </div>
  </div>
</footer>
