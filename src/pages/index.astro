---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import EventCard from '../components/EventCard.astro';
import { client, urlFor } from '../lib/sanity';
import groq from 'groq';

// Fetch latest 3 news posts
let news = [];
try {
  news = await client.fetch(groq`
    *[_type == "news"] | order(publishedAt desc)[0...3] {
      title,
      slug,
      publishedAt,
      coverImage,
      excerpt
    }
  `);
} catch (e) {
  console.error("Error fetching news from Sanity:", e);
}

// Fetch upcoming 3 events
let upcomingEvents = [];
try {
  const now = new Date().toISOString();
  upcomingEvents = await client.fetch(groq`
    *[_type == "event" && startDate >= $now] | order(startDate asc)[0...3] {
      title,
      slug,
      startDate,
      endDate,
      location,
      description,
      image,
      registrationLink
    }
  `, { now });
} catch (e) {
  console.error("Error fetching events from Sanity:", e);
}

const coreValues = [
  "Academic Excellence", "Integrity", "Professionalism", 
  "Unity and Mutual Respect", "Innovation", "Service to Humanity", 
  "Accountability", "Collaboration", "Excellence in Leadership", 
  "Community Development"
];

const objectives = [
  "To foster unity, friendship, and professional collaboration among Chief Lecturers of Offa descent.",
  "To promote multidisciplinary research and scholarly excellence.",
  "To encourage collaborative research addressing developmental challenges in Offa and beyond.",
  "To establish and maintain digital repositories of members' research outputs and innovations.",
  "To publish scholarly journals, research compendia, newsletters, and other academic publications.",
  "To mentor young academics and students.",
  "To facilitate knowledge exchange through conferences, seminars, workshops, and public lectures.",
  "To advise governments, institutions, traditional authorities, and community organisations through evidence-based policy recommendations.",
  "To mobilise intellectual resources for sustainable community development.",
  "To establish partnerships with universities, polytechnics, industries, research institutes, government agencies, and international organisations.",
  "To recognise and celebrate academic excellence and outstanding service.",
  "To encourage entrepreneurship, innovation, and commercialisation of research findings."
];

const strategicFocus = [
  {
    title: "Research for Community Development",
    desc: "Promote research directed towards solving developmental challenges facing Offa and neighbouring communities."
  },
  {
    title: "Research Repository",
    desc: "Develop a digital repository for publications authored by members."
  },
  {
    title: "Research Commercialisation",
    desc: "Create a repository of innovations and research products requiring sponsorship, incubation, and commercialisation."
  },
  {
    title: "ODCLF Peer-Reviewed Journal",
    desc: "Establish and sustain an international multidisciplinary peer-reviewed journal published by the Forum."
  },
  {
    title: "Research Grants",
    desc: "Facilitate collaborative national and international grant applications."
  },
  {
    title: "Annual Research Compendium",
    desc: "Publish annual compilations of members' scholarly works."
  },
  {
    title: "Academic Conferences",
    desc: "Organise annual conferences, seminars, workshops, and distinguished lectures."
  },
  {
    title: "Policy Advisory Services",
    desc: "Provide evidence-based recommendations to the Offa Descendants Union, government, traditional institutions, and other stakeholders."
  },
  {
    title: "Mentorship",
    desc: "Mentor early-career academics, researchers, and students of Offa origin."
  },
  {
    title: "Community Development",
    desc: "Deploy members' expertise in engineering, technology, education, health, agriculture, management, ICT, environmental sustainability, and entrepreneurship for the benefit of Offa."
  },
  {
    title: "Digital Transformation",
    desc: "Develop and maintain the Forum's website, research repository, membership portal, and other digital platforms."
  }
];

const aspirations = [
  "ODCLF Research Institute",
  "Offa Spectrum: A Multidisciplinary Journal of Research, Innovation and Community Development",
  "Annual International Conference",
  "Digital Research Repository",
  "Research Endowment Fund",
  "Young Researchers Mentorship Scheme",
  "Research and Innovation Awards",
  "International Academic Partnerships",
  "Community Development Intervention Projects"
];
---

<Layout title="Home" description="Welcome to the Offa Descendants Chief Lecturers' Forum (ODCLF). A professional body of distinguished Chief Lecturers of Offa descent committed to advancing scholarship, innovation, and community development.">
  <section class="relative text-white py-24 px-4 sm:px-6 lg:px-8 overflow-hidden border-b border-brand-950">
    <!-- Background Image with Dark Overlay for contrast -->
    <div class="absolute inset-0 z-0">
      <img src="/olofa.jpeg" alt="Olofa background" class="w-full h-full object-cover object-center" />
      <div class="absolute inset-0 bg-gradient-to-br from-slate-950/95 via-slate-900/90 to-brand-950/80 mix-blend-multiply"></div>
    </div>

    <div class="absolute inset-0 opacity-5 z-0">
      <div class="absolute inset-0 bg-[radial-gradient(#e2e8f0_1px,transparent_1px)] [background-size:24px_24px]"></div>
    </div>
    
    <div class="max-w-5xl mx-auto text-center relative z-10">
      <span class="inline-flex items-center px-4 py-1.5 rounded-full text-xs font-semibold bg-brand-500/20 text-brand-300 border border-brand-500/30 mb-6 uppercase tracking-wider">
        Offa Descendants Chief Lecturers' Forum
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-6 leading-tight">
        ODCLF
      </h1>
      <p class="text-xl sm:text-2xl font-medium text-brand-200 mb-8 max-w-3xl mx-auto italic">
        "Knowledge & Skills • Innovation • Community Development"
      </p>
      
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4 mt-8">
        <a 
          href="#about" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-semibold rounded-lg bg-white text-brand-900 hover:bg-slate-50 transition-colors shadow-sm"
        >
          Learn More
        </a>
        <a 
          href="/publications" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 border border-slate-700 text-base font-medium rounded-lg text-slate-300 bg-slate-800/50 hover:bg-slate-800 hover:text-white transition-colors"
        >
          Research Repository
        </a>
      </div>
    </div>
  </section>

  <!-- Welcome / Vision / Mission Section -->
  <section id="about" class="bg-white py-20 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Welcome Message -->
        <div class="lg:col-span-7 space-y-6">
          <div class="border-l-4 border-brand-600 pl-4 py-1">
            <h2 class="text-3xl font-bold text-slate-900 tracking-tight">Welcome Message</h2>
          </div>
          <div class="prose prose-slate max-w-none text-slate-600 leading-relaxed space-y-4">
            <p>
              Welcome to the official website of the Offa Descendants Chief Lecturers' Forum (ODCLF).
            </p>
            <p>
              ODCLF is a professional academic body of distinguished Chief Lecturers of Offa descent committed to advancing scholarship, innovation, and community development. The Forum serves as a platform for intellectual collaboration, multidisciplinary research, mentorship, and evidence-based engagement aimed at contributing meaningfully to the sustainable development of Offa, Nigeria, and the global community.
            </p>
            <p>
              Through our collective expertise, we seek to inspire excellence, promote impactful research, strengthen educational advancement, and provide practical solutions to societal challenges.
            </p>
            <p class="font-medium text-slate-800">
              We invite you to explore our activities, publications, members, and initiatives, and to partner with us in building a more prosperous and knowledge-driven society.
            </p>
            <p class="border-t border-slate-100 pt-4 font-semibold text-brand-700 italic">
              Together, we advance knowledge. Together, we develop Offa.
            </p>
          </div>
        </div>

        <!-- Vision & Mission & Monarch -->
        <div class="lg:col-span-5 space-y-6">
          <!-- Vision -->
          <div class="bg-slate-50 border border-slate-200/60 rounded-2xl p-6 shadow-sm">
            <div class="flex items-center space-x-2 text-brand-700 mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              </svg>
              <h3 class="text-lg font-bold text-slate-900 uppercase tracking-wider">Vision</h3>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed">
              To be a foremost community of distinguished polytechnic academics, leveraging knowledge, skills, scholarship, innovation, and professional excellence to advance sustainable development, educational transformation, and the socio-economic progress of Offa, Nigeria, and humanity.           </p>
          </div>

          <!-- Mission -->
          <div class="bg-slate-50 border border-slate-200/60 rounded-2xl p-6 shadow-sm">
            <div class="flex items-center space-x-2 text-brand-700 mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
              </svg>
              <h3 class="text-lg font-bold text-slate-900 uppercase tracking-wider">Mission</h3>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed">
              To unite Chief Lecturers of Offa descent in promoting academic excellence, knowledge and skills development, collaborative research, innovation, mentorship, policy advocacy, and community development through the application of knowledge, practical skills, and professional expertise.           </p>
          </div>

          <!-- Olofa of Offa -->
          <div class="bg-slate-50 border border-slate-200/60 rounded-2xl p-6 shadow-sm flex flex-col sm:flex-row gap-5 items-center sm:items-start hover:border-brand-200 transition-colors duration-200">
            <button class="portrait-zoom-btn w-20 h-20 sm:w-24 sm:h-24 rounded-2xl overflow-hidden shrink-0 border-2 border-brand-100 bg-slate-100 relative shadow-sm hover:scale-105 hover:border-brand-300 transition-all duration-300 group cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-brand-500" data-src="/olofa.jpeg" data-caption="Oba Mufutau Muhammed Oloyede Gbadamosi Ajagungbade I Esuwoye II (The 25th Olofa of Offa Kingdom)" aria-label="View large portrait">
              <img src="/olofa.jpeg" alt="Olofa of Offa" class="w-full h-full object-cover group-hover:brightness-95 transition-all" />
              <div class="absolute inset-0 bg-slate-950/0 group-hover:bg-slate-950/25 flex items-center justify-center transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.637 10.637zM10.5 7.5v6m3-3h-6" />
                </svg>
              </div>
            </button>
            <div class="flex-grow space-y-2 text-center sm:text-left">
              <div class="flex items-center justify-center sm:justify-start space-x-2 text-brand-700">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499c.195-.49.886-.49 1.08 0l2.122 5.344a1 1 0 0 0 .73.664l5.632.748c.539.072.754.733.348 1.134l-4.22 4.148a1 1 0 0 0-.294.905l1.09 5.568c.092.47-.39.818-.847.575L12 18.75l-4.708 2.627c-.457.243-.939-.105-.847-.575l1.09-5.568a1 1 0 0 0-.294-.905l-4.22-4.148c-.406-.401-.191-1.062.348-1.134l5.633-.748a1 1 0 0 0 .73-.664L11.48 3.5Z" />
                </svg>
                <h3 class="text-base font-bold text-slate-900 uppercase tracking-wider">Olofa of Offa</h3>
              </div>
              <p class="text-sm text-slate-600 leading-relaxed">
               Oba Mufutau Muhammed Oloyede Gbadamosi Ajagungbade I Esuwoye II. The 25th Olofa of Offa Kingdom              </p>
            </div>
          </div>

          <!-- ODU Global President -->
          <div class="bg-slate-50 border border-slate-200/60 rounded-2xl p-6 shadow-sm flex flex-col sm:flex-row gap-5 items-center sm:items-start hover:border-brand-200 transition-colors duration-200">
            <button class="portrait-zoom-btn w-20 h-20 sm:w-24 sm:h-24 rounded-2xl overflow-hidden shrink-0 border-2 border-brand-100 bg-slate-100 relative shadow-sm hover:scale-105 hover:border-brand-300 transition-all duration-300 group cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-brand-500" data-src="/olaniyi.png" data-caption="Dr. Muideen Olaniyi Salako (Global President, Offa Descendants Union)" aria-label="View large portrait">
              <img src="/olaniyi.png" alt="Dr. Muideen Olaniyi Salako" class="w-full h-full object-cover group-hover:brightness-95 transition-all" />
              <div class="absolute inset-0 bg-slate-950/0 group-hover:bg-slate-950/25 flex items-center justify-center transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.637 10.637zM10.5 7.5v6m3-3h-6" />
                </svg>
              </div>
            </button>
            <div class="flex-grow space-y-2 text-center sm:text-left">
              <div class="flex items-center justify-center sm:justify-start space-x-2 text-brand-700">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                </svg>
                <h3 class="text-base font-bold text-slate-900 uppercase tracking-wider">Global President, ODU</h3>
              </div>
              <p class="text-sm text-slate-600 leading-relaxed font-medium">
                Dr. Muideen Olaniyi Salako <br /><span class="text-xs text-slate-500 font-normal">Global President, Offa Descendants Union</span>
              </p>
            </div>
          </div>

          <!-- Offa LG Chairman -->
          <div class="bg-slate-50 border border-slate-200/60 rounded-2xl p-6 shadow-sm flex flex-col sm:flex-row gap-5 items-center sm:items-start hover:border-brand-200 transition-colors duration-200">
            <button class="portrait-zoom-btn w-20 h-20 sm:w-24 sm:h-24 rounded-2xl overflow-hidden shrink-0 border-2 border-brand-100 bg-slate-100 relative shadow-sm hover:scale-105 hover:border-brand-300 transition-all duration-300 group cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-brand-500" data-src="/chairman.jpg" data-caption="Chairman Offa Local Government, Offa" aria-label="View large portrait">
              <img src="/chairman.jpg" alt="Offa LG Chairman" class="w-full h-full object-cover group-hover:brightness-95 transition-all" />
              <div class="absolute inset-0 bg-slate-950/0 group-hover:bg-slate-950/25 flex items-center justify-center transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.637 10.637zM10.5 7.5v6m3-3h-6" />
                </svg>
              </div>
            </button>
            <div class="flex-grow space-y-2 text-center sm:text-left">
              <div class="flex items-center justify-center sm:justify-start space-x-2 text-brand-700">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.2" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-.778.099-1.533.284-2.253m0 0A17.919 17.919 0 0 0 12 12.75c3.162 0 6.133-.815 8.716-2.247" />
                </svg>
                <h3 class="text-base font-bold text-slate-900 uppercase tracking-wider">Offa LG Chairman</h3>
              </div>
              <p class="text-sm text-slate-600 leading-relaxed font-medium">
                Chairman Offa local government, Offa
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Core Values & Objectives -->
  <section class="bg-slate-50 py-20 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Core Values -->
      <div class="space-y-8">
        <div class="text-center max-w-3xl mx-auto">
          <h2 class="text-3xl font-bold text-slate-900">Core Values</h2>
          <p class="text-slate-500 mt-2 text-sm sm:text-base">The foundational pillars that guide the decisions and actions of the Forum.</p>
        </div>
        
        <div class="flex flex-wrap justify-center gap-4">
          {coreValues.map((val) => (
            <span class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold bg-white text-slate-700 border border-slate-200 shadow-sm transition-transform hover:-translate-y-0.5 duration-200">
              <span class="w-2 h-2 rounded-full bg-brand-500 mr-2.5"></span>
              {val}
            </span>
          ))}
        </div>
      </div>

      <!-- Objectives -->
      <div class="space-y-8 pt-8 border-t border-slate-200/60">
        <div class="text-center max-w-3xl mx-auto">
          <h2 class="text-3xl font-bold text-slate-900">Objectives</h2>
          <p class="text-slate-500 mt-2 text-sm sm:text-base">Our action goals to encourage growth, scholarship, and advocacy.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {objectives.map((obj, i) => (
            <div class="bg-white p-5 rounded-2xl border border-slate-200/60 shadow-sm flex items-start space-x-3.5 hover:border-brand-200 transition-colors duration-200">
              <div class="w-7 h-7 rounded-lg bg-brand-50 text-brand-600 flex items-center justify-center font-bold text-sm shrink-0">
                {i + 1}
              </div>
              <p class="text-slate-600 text-sm leading-relaxed">{obj}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Strategic Areas of Focus -->
  <section class="bg-white py-20 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-slate-900">Strategic Areas of Focus</h2>
        <p class="text-slate-500 mt-2">Targeted domains where members apply academic and professional expertise.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {strategicFocus.map((focus) => (
          <div class="p-6 rounded-2xl border border-slate-100 bg-slate-50 hover:bg-white hover:border-brand-200 hover:shadow-sm transition-all duration-300 flex flex-col justify-between">
            <h3 class="font-bold text-slate-900 text-base mb-3 leading-snug">{focus.title}</h3>
            <p class="text-slate-500 text-sm leading-relaxed">{focus.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Membership & Long-Term Aspirations -->
  <section class="bg-slate-900 text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-16">
      
      <!-- Membership -->
      <div class="space-y-6 lg:pr-8">
        <h2 class="text-3xl font-bold text-white border-l-4 border-brand-500 pl-4 py-1">Membership</h2>
        <p class="text-slate-300 leading-relaxed text-base">
          Membership comprises Chief Lecturers of Offa descent serving in Nigerian Polytechnics and allied tertiary institutions, together with such other categories of membership as may be provided in the Constitution.
        </p>
        <div class="pt-4">
          <a 
            href="/members" 
            class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg text-sm font-semibold bg-brand-600 text-white hover:bg-brand-500 transition-colors"
          >
            Meet Our Members
          </a>
        </div>
      </div>

      <!-- Long-Term Aspirations -->
      <div class="space-y-6">
        <h2 class="text-3xl font-bold text-white border-l-4 border-brand-500 pl-4 py-1">Long-Term Aspirations</h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
          {aspirations.map((asp) => (
            <div class="flex items-center space-x-3 text-slate-300">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-brand-400 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              <span class="text-sm font-medium">{asp}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Dynamic Content: News & Events -->
  <section class="bg-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-16">
      
      <!-- News Panel -->
      <div class="space-y-8">
        <div class="flex items-end justify-between border-b border-slate-100 pb-4">
          <h2 class="text-2xl font-bold text-slate-900">Latest News & Updates</h2>
          <a href="/news" class="text-sm font-semibold text-brand-600 hover:text-brand-800 transition-colors">
            View All
          </a>
        </div>

        {news && news.length > 0 ? (
          <div class="space-y-6">
            {news.slice(0, 2).map((post) => (
              <div class="bg-slate-50 border border-slate-100 p-5 rounded-2xl flex flex-col sm:flex-row gap-4 hover:shadow-sm transition-shadow duration-300">
                {post.coverImage && (
                  <div class="w-full sm:w-28 h-20 shrink-0 bg-slate-100 rounded-lg overflow-hidden">
                    <img src={urlFor(post.coverImage).width(200).height(150).url()} alt={post.title} class="w-full h-full object-cover" />
                  </div>
                )}
                <div class="flex-grow flex flex-col justify-between">
                  <h3 class="font-bold text-slate-900 hover:text-brand-600 text-sm line-clamp-2">
                    <a href={`/news/${post.slug.current}`}>{post.title}</a>
                  </h3>
                  <p class="text-xs text-slate-400 font-medium mt-2">
                    {new Date(post.publishedAt).toLocaleDateString()}
                  </p>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-slate-400 italic py-6">No news posts found yet.</p>
        )}
      </div>

      <!-- Events Panel -->
      <div class="space-y-8">
        <div class="flex items-end justify-between border-b border-slate-100 pb-4">
          <h2 class="text-2xl font-bold text-slate-900">Upcoming Events</h2>
          <a href="/events" class="text-sm font-semibold text-brand-600 hover:text-brand-800 transition-colors">
            View All
          </a>
        </div>

        {upcomingEvents && upcomingEvents.length > 0 ? (
          <div class="space-y-6">
            {upcomingEvents.slice(0, 2).map((event) => (
              <div class="bg-slate-50 border border-slate-100 p-5 rounded-2xl flex flex-col sm:flex-row gap-4 hover:shadow-sm transition-shadow duration-300">
                {event.image && (
                  <div class="w-full sm:w-28 h-20 shrink-0 bg-slate-100 rounded-lg overflow-hidden">
                    <img src={urlFor(event.image).width(200).height(150).url()} alt={event.title} class="w-full h-full object-cover" />
                  </div>
                )}
                <div class="flex-grow flex flex-col justify-between">
                  <div>
                    <h3 class="font-bold text-slate-900 hover:text-brand-600 text-sm line-clamp-1">
                      <a href={`/events/${event.slug.current}`}>{event.title}</a>
                    </h3>
                    <p class="text-slate-400 text-xs mt-1.5 truncate">{event.location}</p>
                  </div>
                  <p class="text-xs text-brand-600 font-bold mt-2">
                    {new Date(event.startDate).toLocaleDateString()}
                  </p>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-slate-400 italic py-6">No upcoming events scheduled.</p>
        )}
      </div>

    </div>
  </section>

  <!-- Lightbox Modal for Portrait Images -->
  <div id="portrait-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/90 backdrop-blur-md cursor-zoom-out">
    <div class="relative max-w-4xl max-h-[90vh] p-4 flex flex-col items-center justify-center animate-fade-in">
      <img id="modal-portrait-img" src="" alt="" class="max-w-full max-h-[80vh] rounded-2xl shadow-2xl border border-slate-800 object-contain" />
      <p id="modal-portrait-caption" class="text-white text-sm font-medium mt-4 text-center px-4 bg-slate-900/60 py-2 rounded-full border border-slate-800/80 max-w-xl">
      </p>
      <button id="close-portrait-modal" class="absolute top-4 right-4 text-white hover:text-slate-300 p-2 focus:outline-none bg-slate-900/80 hover:bg-slate-800 rounded-full border border-slate-800 transition-colors" aria-label="Close modal">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
</Layout>

<script>
  const modal = document.getElementById('portrait-modal');
  const modalImg = document.getElementById('modal-portrait-img') as HTMLImageElement;
  const modalCaption = document.getElementById('modal-portrait-caption');
  const closeBtn = document.getElementById('close-portrait-modal');

  if (modal) {
    // Catch clicks on any trigger element using class selector
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.portrait-zoom-btn');
      if (btn) {
        const src = btn.getAttribute('data-src') || '';
        const caption = btn.getAttribute('data-caption') || '';
        
        if (modalImg) {
          modalImg.src = src;
          modalImg.alt = caption;
        }
        if (modalCaption) {
          modalCaption.textContent = caption;
        }
        
        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
      }
    });

    const closeModal = () => {
      modal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    };

    closeBtn?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }
</script>
