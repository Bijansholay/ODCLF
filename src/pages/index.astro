---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import EventCard from '../components/EventCard.astro';
import { client } from '../lib/sanity';
import groq from 'groq';

// Fetch latest 3 news posts
let news = [];
try {
  news = await client.fetch(groq`
    *[_type == "news"] | order(publishedAt desc)[0...3] {
      title,
      slug,
      publishedAt,
      coverImage,
      excerpt
    }
  `);
} catch (e) {
  console.error("Error fetching news from Sanity:", e);
}

// Fetch upcoming 3 events
let upcomingEvents = [];
try {
  const now = new Date().toISOString();
  upcomingEvents = await client.fetch(groq`
    *[_type == "event" && startDate >= $now] | order(startDate asc)[0...3] {
      title,
      slug,
      startDate,
      endDate,
      location,
      description,
      image,
      registrationLink
    }
  `, { now });
} catch (e) {
  console.error("Error fetching events from Sanity:", e);
}
---

<Layout title="Home" description="Welcome to the Forum - a university hub for academic dialogue, news, member profiles, and research publications.">
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-brand-900 via-brand-800 to-slate-900 text-white py-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0 bg-[radial-gradient(#e2e8f0_1px,transparent_1px)] [background-size:24px_24px]"></div>
    </div>
    
    <div class="max-w-5xl mx-auto text-center relative z-10">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-brand-500/20 text-brand-300 border border-brand-500/30 mb-6 uppercase tracking-wider">
        Official University Forum
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-6 leading-tight">
        Fostering Academic Discourse <br class="hidden sm:inline" />& Research Collaboration
      </h1>
      <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
        Connecting students, researchers, and officers through shared publications, regular academic events, and departmental updates.
      </p>
      
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
        <a 
          href="/events" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-semibold rounded-lg bg-white text-brand-900 hover:bg-slate-50 transition-colors shadow-sm"
        >
          View Events
        </a>
        <a 
          href="/publications" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 border border-slate-700 text-base font-medium rounded-lg text-slate-300 bg-slate-800/50 hover:bg-slate-800 hover:text-white transition-colors"
        >
          Browse Publications
        </a>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">
    <!-- News Panel -->
    <section class="space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-100 pb-4">
        <div>
          <h2 class="text-3xl font-bold text-slate-900">Latest News & Updates</h2>
          <p class="text-slate-500 mt-1">Stay informed with the latest announcements and articles.</p>
        </div>
        <a 
          href="/news" 
          class="inline-flex items-center text-sm font-semibold text-brand-600 hover:text-brand-800 transition-colors shrink-0"
        >
          View All News
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 ml-1">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      {news && news.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {news.map((post) => (
            <NewsCard post={post} />
          ))}
        </div>
      ) : (
        <div class="text-center py-16 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 text-slate-400 mx-auto mb-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18V6a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 6v3.75m-18 0A2.25 2.25 0 0 0 5.25 12h13.5M3 12h18" />
          </svg>
          <p class="text-slate-500 font-medium">No news posts found yet.</p>
          <p class="text-slate-400 text-sm mt-1">News updates will appear here once published in the dashboard.</p>
        </div>
      )}
    </section>

    <!-- Events Panel -->
    <section class="space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-100 pb-4">
        <div>
          <h2 class="text-3xl font-bold text-slate-900">Upcoming Events</h2>
          <p class="text-slate-500 mt-1">Academic workshops, conferences, and student forums.</p>
        </div>
        <a 
          href="/events" 
          class="inline-flex items-center text-sm font-semibold text-brand-600 hover:text-brand-800 transition-colors shrink-0"
        >
          View All Events
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 ml-1">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      {upcomingEvents && upcomingEvents.length > 0 ? (
        <div class="grid grid-cols-1 gap-6">
          {upcomingEvents.map((event) => (
            <EventCard event={event} />
          ))}
        </div>
      ) : (
        <div class="text-center py-16 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 text-slate-400 mx-auto mb-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
          </svg>
          <p class="text-slate-500 font-medium">No upcoming events listed.</p>
          <p class="text-slate-400 text-sm mt-1">Check back later or check out the archive for past events.</p>
        </div>
      )}
    </section>
  </div>
</Layout>
