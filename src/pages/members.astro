---
import Layout from '../layouts/Layout.astro';
import MemberCard from '../components/MemberCard.astro';
import { client } from '../lib/sanity';
import groq from 'groq';

let members = [];
let pastMembers = [];

try {
  // Fetch active officers sorted by 'order' ascending
  members = await client.fetch(groq`
    *[_type == "member" && active == true] | order(order asc) {
      name,
      role,
      photo,
      shortBio,
      bio,
      category,
      emails,
      phone,
      active
    }
  `);

  // Fetch past officers sorted by 'order' ascending
  pastMembers = await client.fetch(groq`
    *[_type == "member" && active == false] | order(order asc) {
      name,
      role,
      photo,
      shortBio,
      bio,
      category,
      emails,
      phone,
      active
    }
  `);
} catch (e) {
  console.error("Error fetching members:", e);
}

// Split active members by their category field
const coordinators = members.filter(m => m.category === 'coordinator');
const exco = members.filter(m => m.category === 'exco');
const distinguished = members.filter(m => !m.category || m.category === 'distinguished');
---

<Layout title="Members" description="Meet the active officers and past board members of the forum.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    <!-- Header -->
    <div class="border-b border-slate-200 pb-6">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">Meet Our Members</h1>
      <p class="text-slate-500 mt-2">The dedicated team behind the organization, steering discussions and initiatives.</p>
    </div>

    <!-- National Coordinator -->
    <section class="space-y-8">
      <div class="border-l-4 border-brand-500 pl-4 py-1">
        <h2 class="text-2xl font-bold text-slate-900">National Coordinator</h2>
        <p class="text-sm text-slate-500 mt-0.5">The National Coordinator provides overall leadership and coordination, driving the realisation of ODCLF’s objectives, purpose, programmes, and sustainable developmen</p>
      </div>

      {coordinators && coordinators.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {coordinators.map((member) => (
            <MemberCard member={member} />
          ))}
        </div>
      ) : (
        <div class="text-center py-12 bg-white rounded-2xl border border-slate-100 shadow-sm">
          <p class="text-slate-400 italic text-sm">No coordinator profiles found. Add profiles with category 'National Coordinator' in the CMS.</p>
        </div>
      )}
    </section>

    <!-- Interim Coordinating (EXCO) Officers -->
    <section class="space-y-8 pt-8 border-t border-slate-100">
      <div class="border-l-4 border-brand-500 pl-4 py-1">
        <h2 class="text-2xl font-bold text-slate-900">Interim Coordinating (EXCO) Officers</h2>
        <p class="text-sm text-slate-500 mt-0.5">The Interim Executive Committee collectively supports and complements the efforts of the National Coordinator in an executive capacity towards driving the realisation of ODCLF’s objectives, purpose, and sustainable development.</p>
      </div>

      {exco && exco.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {exco.map((member) => (
            <MemberCard member={member} />
          ))}
        </div>
      ) : (
        <div class="text-center py-12 bg-white rounded-2xl border border-slate-100 shadow-sm">
          <p class="text-slate-400 italic text-sm">No EXCO profiles found. Add profiles with category 'Interim Coordinating (EXCO) Officer' in the CMS.</p>
        </div>
      )}
    </section>

    <!-- Distinguished Members -->
    <section class="space-y-8 pt-8 border-t border-slate-100">
      <div class="border-l-4 border-brand-500 pl-4 py-1">
        <h2 class="text-2xl font-bold text-slate-900">Distinguished Members</h2>
        <p class="text-sm text-slate-500 mt-0.5">The Distinguished Members contribute their knowledge, skills, experience, and professional networks towards advancing ODCLF’s objectives, purpose, and sustainable development.</p>
      </div>

      {distinguished && distinguished.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {distinguished.map((member) => (
            <MemberCard member={member} />
          ))}
        </div>
      ) : (
        <div class="text-center py-12 bg-white rounded-2xl border border-slate-100 shadow-sm">
          <p class="text-slate-400 italic text-sm">No distinguished member profiles found. Add profiles with category 'Distinguished Member' in the CMS.</p>
        </div>
      )}
    </section>

    <!-- Past Officers (Alumni) -->
    {pastMembers && pastMembers.length > 0 && (
      <section class="space-y-8 pt-8 border-t border-slate-100">
        <div class="border-l-4 border-slate-400 pl-4 py-1">
          <h2 class="text-2xl font-bold text-slate-800">Past Officers & Alumni</h2>
          <p class="text-sm text-slate-500 mt-0.5">Honoring those who served the forum in previous terms.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {pastMembers.map((member) => (
            <MemberCard member={member} />
          ))}
        </div>
      </section>
    )}
  </div>
  <!-- Member Details Lightbox Modal -->
  <div id="member-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4">
    <div class="bg-gradient-to-br from-brand-900 to-slate-950 w-full max-w-2xl rounded-2xl shadow-2xl border-2 border-brand-500/30 p-6 sm:p-8 relative flex flex-col md:flex-row gap-6 max-h-[90vh] overflow-hidden text-white">
      
      <!-- Close Button -->
      <button id="close-member-modal" class="absolute top-4 right-4 text-slate-300 hover:text-white p-2 focus:outline-none bg-slate-950/60 hover:bg-brand-950 rounded-full border border-brand-900 transition-colors" aria-label="Close modal">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Large Member Photo & Contacts Container -->
      <div class="flex flex-col items-center shrink-0 mx-auto md:mx-0">
        <div class="w-32 h-32 sm:w-44 sm:h-44 rounded-2xl overflow-hidden border-2 border-brand-400 bg-slate-800 relative shadow-lg flex items-center justify-center">
          <img id="modal-member-photo" src="" alt="" class="w-full h-full object-cover hidden" />
          <div id="modal-member-initials" class="w-full h-full flex items-center justify-center bg-gradient-to-br from-brand-600 to-brand-700 text-white font-bold text-3xl tracking-wider hidden">
          </div>
        </div>
        
        <!-- Contact details section under the photo -->
        <div id="modal-member-contacts" class="mt-4 space-y-2.5 text-center w-full hidden border-t border-brand-900/60 pt-4">
          <div id="modal-emails-container" class="space-y-2 flex flex-col items-center">
            <!-- Dynamic emails will render here -->
          </div>
          <div id="modal-phone-row" class="flex items-center justify-center space-x-2 text-xs text-slate-300">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-brand-400 shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-1.514 2.018a14.977 14.977 0 0 1-8.184-8.184l2.018-1.514c.361-.27.527-.732.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span id="modal-member-phone" class="truncate"></span>
          </div>
        </div>
      </div>

      <!-- Text Details Container -->
      <div class="flex-grow flex flex-col justify-between overflow-y-auto max-h-[50vh] md:max-h-[70vh] pr-2 space-y-4">
        <div>
          <h2 id="modal-member-name" class="text-2xl font-bold tracking-tight text-white"></h2>
          <span id="modal-member-role" class="inline-block mt-1.5 text-xs font-semibold uppercase tracking-wider text-brand-300 bg-brand-950 border border-brand-900 px-2.5 py-0.5 rounded-full"></span>
          
          <div class="border-t border-brand-900/60 pt-4 mt-4">
            <h4 class="text-xs font-bold text-brand-400 uppercase tracking-wider mb-2">Biography</h4>
            <p id="modal-member-bio" class="text-slate-300 text-sm leading-relaxed whitespace-pre-line text-left"></p>
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
  const modal = document.getElementById('member-modal');
  const closeBtn = document.getElementById('close-member-modal');
  
  const modalName = document.getElementById('modal-member-name');
  const modalRole = document.getElementById('modal-member-role');
  const modalBio = document.getElementById('modal-member-bio');
  const modalPhoto = document.getElementById('modal-member-photo') as HTMLImageElement;
  const modalInitials = document.getElementById('modal-member-initials');

  if (modal) {
    // Event delegation: listen for click on any element with .member-detail-trigger
    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest('.member-detail-trigger');
      if (trigger) {
        const card = trigger.closest('.member-card');
        if (card) {
          const name = card.getAttribute('data-name') || '';
          const role = card.getAttribute('data-role') || '';
          const bio = card.getAttribute('data-bio') || 'No biography provided.';
          const photo = card.getAttribute('data-photo') || '';
          const initials = card.getAttribute('data-initials') || '??';
          const emailsAttr = card.getAttribute('data-emails') || '[]';
          const phone = card.getAttribute('data-phone') || '';

          let emails = [];
          try {
            emails = JSON.parse(emailsAttr);
          } catch (e) {
            emails = [];
          }

          if (modalName) modalName.textContent = name;
          if (modalRole) modalRole.textContent = role;
          if (modalBio) modalBio.textContent = bio;

          // Render multiple emails dynamically
          const emailsContainer = document.getElementById('modal-emails-container');
          if (emailsContainer) {
            emailsContainer.innerHTML = ''; // clear out old ones
            if (emails && emails.length > 0) {
              emails.forEach((email: string) => {
                const row = document.createElement('div');
                row.className = 'flex items-center justify-center space-x-2 text-xs text-slate-300 hover:text-white transition-colors w-full';
                row.innerHTML = `
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-brand-400 shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
                  </svg>
                  <a href="mailto:${email}" class="hover:underline truncate max-w-[170px] text-slate-300 hover:text-white font-medium">${email}</a>
                `;
                emailsContainer.appendChild(row);
              });
              emailsContainer.classList.remove('hidden');
            } else {
              emailsContainer.classList.add('hidden');
            }
          }

          // Update Phone link & visibility
          const phoneRow = document.getElementById('modal-phone-row');
          const phoneVal = document.getElementById('modal-member-phone');
          if (phone) {
            if (phoneVal) phoneVal.textContent = phone;
            phoneRow?.classList.remove('hidden');
          } else {
            phoneRow?.classList.add('hidden');
          }

          // Show Contacts Block container if either emails or phone exists
          const contactsBlock = document.getElementById('modal-member-contacts');
          if (emails.length > 0 || phone) {
            contactsBlock?.classList.remove('hidden');
          } else {
            contactsBlock?.classList.add('hidden');
          }

          if (photo) {
            if (modalPhoto) {
              modalPhoto.src = photo;
              modalPhoto.alt = name;
              modalPhoto.classList.remove('hidden');
            }
            if (modalInitials) modalInitials.classList.add('hidden');
          } else {
            if (modalPhoto) modalPhoto.classList.add('hidden');
            if (modalInitials) {
              modalInitials.textContent = initials;
              modalInitials.classList.remove('hidden');
            }
          }

          modal.classList.remove('hidden');
          document.body.classList.add('overflow-hidden');
        }
      }
    });

    const closeModal = () => {
      modal.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    };

    closeBtn?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }
</script>
