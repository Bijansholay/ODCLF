---
import Layout from '../layouts/Layout.astro';
import MemberCard from '../components/MemberCard.astro';
import { client } from '../lib/sanity';
import groq from 'groq';

let members = [];
let pastMembers = [];

try {
  // Fetch active officers sorted by 'order' ascending
  members = await client.fetch(groq`
    *[_type == "member" && active == true] | order(order asc) {
      name,
      role,
      photo,
      bio,
      category,
      active
    }
  `);

  // Fetch past officers sorted by 'order' ascending
  pastMembers = await client.fetch(groq`
    *[_type == "member" && active == false] | order(order asc) {
      name,
      role,
      photo,
      bio,
      category,
      active
    }
  `);
} catch (e) {
  console.error("Error fetching members:", e);
}

// Split active members by their category field
const coordinators = members.filter(m => m.category === 'coordinator');
const exco = members.filter(m => m.category === 'exco');
const distinguished = members.filter(m => !m.category || m.category === 'distinguished');
---

<Layout title="Members" description="Meet the active officers and past board members of the forum.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    <!-- Header -->
    <div class="border-b border-slate-200 pb-6">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">Meet Our Members</h1>
      <p class="text-slate-500 mt-2">The dedicated team behind the organization, steering discussions and initiatives.</p>
    </div>

    <!-- National Coordinator -->
    <section class="space-y-8">
      <div class="border-l-4 border-brand-500 pl-4 py-1">
        <h2 class="text-2xl font-bold text-slate-900">National Coordinator</h2>
        <p class="text-sm text-slate-500 mt-0.5">The leadership representing and directing the forum.</p>
      </div>

      {coordinators && coordinators.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {coordinators.map((member) => (
            <MemberCard member={member} />
          ))}
        </div>
      ) : (
        <div class="text-center py-12 bg-white rounded-2xl border border-slate-100 shadow-sm">
          <p class="text-slate-400 italic text-sm">No coordinator profiles found. Add profiles with category 'National Coordinator' in the CMS.</p>
        </div>
      )}
    </section>

    <!-- Interim Coordinating (EXCO) Officers -->
    <section class="space-y-8 pt-8 border-t border-slate-100">
      <div class="border-l-4 border-brand-500 pl-4 py-1">
        <h2 class="text-2xl font-bold text-slate-900">Interim Coordinating (EXCO) Officers</h2>
        <p class="text-sm text-slate-500 mt-0.5">The executive officers steering discussions, events, and academic projects.</p>
      </div>

      {exco && exco.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {exco.map((member) => (
            <MemberCard member={member} />
          ))}
        </div>
      ) : (
        <div class="text-center py-12 bg-white rounded-2xl border border-slate-100 shadow-sm">
          <p class="text-slate-400 italic text-sm">No EXCO profiles found. Add profiles with category 'Interim Coordinating (EXCO) Officer' in the CMS.</p>
        </div>
      )}
    </section>

    <!-- Distinguished Members -->
    <section class="space-y-8 pt-8 border-t border-slate-100">
      <div class="border-l-4 border-brand-500 pl-4 py-1">
        <h2 class="text-2xl font-bold text-slate-900">Distinguished Members</h2>
        <p class="text-sm text-slate-500 mt-0.5">Academic members of Offa descent participating in our forums and research.</p>
      </div>

      {distinguished && distinguished.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {distinguished.map((member) => (
            <MemberCard member={member} />
          ))}
        </div>
      ) : (
        <div class="text-center py-12 bg-white rounded-2xl border border-slate-100 shadow-sm">
          <p class="text-slate-400 italic text-sm">No distinguished member profiles found. Add profiles with category 'Distinguished Member' in the CMS.</p>
        </div>
      )}
    </section>

    <!-- Past Officers (Alumni) -->
    {pastMembers && pastMembers.length > 0 && (
      <section class="space-y-8 pt-8 border-t border-slate-100">
        <div class="border-l-4 border-slate-400 pl-4 py-1">
          <h2 class="text-2xl font-bold text-slate-800">Past Officers & Alumni</h2>
          <p class="text-sm text-slate-500 mt-0.5">Honoring those who served the forum in previous terms.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {pastMembers.map((member) => (
            <MemberCard member={member} />
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.toggle-bio-btn');
    if (btn) {
      const container = btn.closest('.bio-container');
      if (container) {
        const truncated = container.querySelector('.bio-truncated');
        const full = container.querySelector('.bio-full');

        if (truncated && full) {
          const isExpanded = truncated.classList.contains('hidden');
          if (isExpanded) {
            // Collapse
            truncated.classList.remove('hidden');
            full.classList.add('hidden');
            btn.textContent = 'Read Biography';
            
            // Smoothly scroll the card back into view if collapsing
            const card = btn.closest('.member-card');
            card?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } else {
            // Expand
            truncated.classList.add('hidden');
            full.classList.remove('hidden');
            btn.textContent = 'Read Less';
          }
        }
      }
    }
  });
</script>
