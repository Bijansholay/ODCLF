---
import Layout from '../layouts/Layout.astro';
import MemberCard from '../components/MemberCard.astro';
import { client } from '../lib/sanity';
import groq from 'groq';

let activeMembers = [];
let pastMembers = [];

try {
  // Fetch active officers sorted by 'order' ascending
  activeMembers = await client.fetch(groq`
    *[_type == "member" && active == true] | order(order asc) {
      name,
      role,
      photo,
      bio,
      active
    }
  `);

  // Fetch past officers sorted by 'order' ascending
  pastMembers = await client.fetch(groq`
    *[_type == "member" && active == false] | order(order asc) {
      name,
      role,
      photo,
      bio,
      active
    }
  `);
} catch (e) {
  console.error("Error fetching members:", e);
}
---

<Layout title="Members" description="Meet the active officers and past board members of the forum.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    <!-- Header -->
    <div class="border-b border-slate-200 pb-6">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">Meet Our Members</h1>
      <p class="text-slate-500 mt-2">The dedicated team behind the organization, steering discussions and initiatives.</p>
    </div>

    <!-- Active Officers -->
    <section class="space-y-8">
      <div class="border-l-4 border-brand-500 pl-4 py-1">
        <h2 class="text-2xl font-bold text-slate-900">Current Officers</h2>
        <p class="text-sm text-slate-500 mt-0.5">The active leaders organizing forums and publishing research updates.</p>
      </div>

      {activeMembers && activeMembers.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {activeMembers.map((member) => (
            <MemberCard member={member} />
          ))}
        </div>
      ) : (
        <div class="text-center py-16 bg-white rounded-2xl border border-slate-100 shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-16 h-16 text-slate-300 mx-auto mb-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
          </svg>
          <p class="text-slate-500 font-medium">No active officers found</p>
          <p class="text-slate-400 text-sm mt-1">Officer profiles will display here once added to the CMS.</p>
        </div>
      )}
    </section>

    <!-- Past Officers (Alumni) -->
    {pastMembers && pastMembers.length > 0 && (
      <section class="space-y-8 pt-8 border-t border-slate-100">
        <div class="border-l-4 border-slate-400 pl-4 py-1">
          <h2 class="text-2xl font-bold text-slate-800">Past Officers & Alumni</h2>
          <p class="text-sm text-slate-500 mt-0.5">Honoring those who served the forum in previous terms.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {pastMembers.map((member) => (
            <MemberCard member={member} />
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
